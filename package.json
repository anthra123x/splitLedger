{
  "name": "split-ledger",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "SplitLedger - Plataforma Inteligente de Descomposición y Conciliación Forense de Facturas con IA (TypeScript)",
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:backend": "cd backend && php artisan serve --port=8001",
    "dev:client": "cd client && npm run dev",
    "dev:ai": "cd ai_engine && uv run uvicorn app.main:app --port 8100 --reload",
    "build:client": "cd client && npm run build",
    "build": "npm run build:client",
    "start": "cd backend && php artisan serve --port=8001"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.10",
    "@types/pdf-parse": "^1.1.4",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
